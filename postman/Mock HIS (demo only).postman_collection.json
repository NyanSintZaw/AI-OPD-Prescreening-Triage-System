    {
      "name": "POST /api/visits/{visit_id}/prescreen",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{HIS_API_KEY}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{HIS_BASE_URL}}/api/visits/{{visit_id}}/prescreen",
          "host": [
            "{{HIS_BASE_URL}}"
          ],
          "path": [
            "api",
            "visits",
            "{{visit_id}}",
            "prescreen"
          ]
        },
        "description": "Stage 1 write-back — objective booth data only.\n\nWrites the measurements taken at our booth + the booth as\nfirst_location/measure onto the visit row. The clinical narrative\n(complaint summary, reason) and the recommended department are HELD\nin prescreen_results (pending) and NOT published to the visit row\nuntil a nurse confirms at the destination (Stage 2).",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"session_ref\": \"string\",\n  \"slip_code\": \"string\",\n  \"recommended_department\": \"string\",\n  \"complaint\": \"string\",\n  \"reason\": \"string\",\n  \"vitals\": {},\n  \"reasons\": [\n    \"string\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "GET /api/visits/{visit_id}/prescreen",
      "request": {
