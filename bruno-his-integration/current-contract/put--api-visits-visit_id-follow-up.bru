meta {
  name: PUT /api/visits/{visit_id}/follow-up
  type: http
  seq: 5
}

put {
  url: {{hisBaseUrl}}/api/visits/{{visit_id}}/follow-up
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{hisToken}}
  X-API-Key: {{hisToken}}
}

body:json {
  {
    "follow_up": "string"
  }
}

docs {
  WE PUT — follow-up note captured during the interview (HttpHisAdapter.push_follow_up).
  
  Record the patient's own follow-up question/concern from the booth.
  
  Written as soon as the patient states it (end of the booth flow) —
  unlike the nurse narrative it needs no human sign-off, it IS the
  patient's verbatim words for the doctor.
}
