meta {
  name: POST /api/visits/{visit_id}/prescreen
  type: http
  seq: 3
}

post {
  url: {{hisBaseUrl}}/api/visits/{{visit_id}}/prescreen
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{hisToken}}
  X-API-Key: {{hisToken}}
}

body:json {
  {
    "session_ref": "string",
    "slip_code": "string",
    "recommended_department": "string",
    "complaint": "string",
    "reason": "string",
    "vitals": {},
    "reasons": [
      "string"
    ]
  }
}

docs {
  WE POST — Stage 1 write-back: AI prescreen result right after the booth session (HttpHisAdapter.push_referral).
  
  Stage 1 write-back — objective booth data only.
  
  Writes the measurements taken at our booth + the booth as
  first_location/measure onto the visit row. The clinical narrative
  (complaint summary, reason) and the recommended department are HELD
  in prescreen_results (pending) and NOT published to the visit row
  until a nurse confirms at the destination (Stage 2).
}
