  "/api/patients/{hn}/history": {
   "put": {
    "summary": "Update Patient History",
    "description": "Record first-time-patient history collected at the booth.\n\nUpserts the full history (no partial-field merge, matching this\nservice's other write-back endpoints) and stamps\n``history_recorded_at`` — from this point on the patient is no\nlonger first-time, on this visit and any future one.",
    "operationId": "update_patient_history_api_patients__hn__history_put",
    "parameters": [
     {
