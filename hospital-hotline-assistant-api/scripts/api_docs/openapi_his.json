  "/api/admin/reset": {
   "post": {
    "summary": "Reset Visits",
    "description": "Testing convenience: return visits to their pre-registration\n(\"registered\") state so a demo can be re-run against the same visit\nIDs. Clears the held prescreen results and NULLs every screening\ncolumn our system writes back (booth measurements, first/second\nlocation, nurse narrative). Pre-registration fields\n(visit_id / hnx / birthdate / appointment) are untouched.\n\nWith ``visit_ids`` it resets only those; otherwise it resets every\nvisit. Note: against a completed real export (``HIS_MOCK_DATA_PATH``)\nthis also clears the export's screening fields — it is a demo/test tool.\n\nPatient (HN) history is left alone by default, since it's meant to\ncarry across visits — pass ``reset_history: true`` to also wipe the\naffected patients' history/last-vitals back to \"first-time\" so that\nflow can be re-demoed against the same synthetic HNs.",
    "operationId": "reset_visits_api_admin_reset_post",
    "parameters": [
     {
      "name": "x-api-key",
      "in": "header",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "X-Api-Key"
      }
     }
    ],
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
