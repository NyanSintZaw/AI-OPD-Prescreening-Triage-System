 "openapi": "3.1.0",
 "info": {
  "title": "Hospital HIS (mock)",
  "description": "Simulates the hospital's visit database behind a REST API. The data in here belongs to the 'hospital side' of the demo — the triage system can only reach it through these endpoints.",
  "version": "0.1.0"
 },
