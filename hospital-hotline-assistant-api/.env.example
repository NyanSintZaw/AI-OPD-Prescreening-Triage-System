DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hospital_hotline
APP_NAME=Hospital Hotline Assistant API
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]
MOCK_NOTIFIER_ENABLED=true
NOTIFICATION_WEBHOOK_URL=
ALERT_SEVERITY_THRESHOLD=emergency
ALERT_COOLDOWN_SECONDS=300
GOOGLE_AI_ENABLED=true
# Switch google-genai (and ADK underneath it) to Vertex AI mode. When true,
# auth comes from GOOGLE_APPLICATION_CREDENTIALS + project/location below;
# no API key is needed. Set to false to use the Gemini API with GOOGLE_API_KEY.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
# General Gemini model for non-triage features (e.g. surveillance extraction).
GOOGLE_MODEL_NAME=gemini-3.5-flash
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ── AI mode: ONE switch for the LLM + STT + TTS backends ───────────────────
# local  — everything on-prem via the local-speech gateway; no patient text or
#          audio leaves the building. OVERRIDES the three *_PROVIDER settings
#          below and fills in any base URL left unset from LOCAL_AI_BASE_URL,
#          so they cannot drift out of sync with each other.
# cloud  — Gemini on Vertex AI + Google Cloud STT/TTS.
# custom — leave the *_PROVIDER settings below exactly as written.
#
# Setting the base URLs WITHOUT setting this to `local` is the trap: the stack
# looks on-prem but the providers are still vertexai/google, so audio still
# goes to the cloud. run-local.sh / run-local.ps1 set AI_MODE=local for you.
AI_MODE=custom
# Used only when AI_MODE picks the mode; a Gemini id is meaningless to Ollama.
# LOCAL_SCREENING_MODEL_NAME must match a model in `ollama list`.
# CLOUD_SCREENING_MODEL_NAME=gemini-3.1-flash-lite
# LOCAL_SCREENING_MODEL_NAME=scb10x/llama3.1-typhoon2-8b-instruct
# localhost when the gateway runs on THIS machine. When it runs on the booth
# workstation, use its Tailscale MagicDNS name rather than an IP — the campus
# DHCP lease moves and every change breaks the stack in a way that looks like
# a timeout. See docs/local-ai-connecting.md §2.
# LOCAL_AI_BASE_URL=http://localhost:8090/v1
# LOCAL_AI_BASE_URL=http://desktop-hh9005e.tail310b75.ts.net:8090/v1

# ── Screening engine (LangGraph — the only triage/voice engine) ─────────────
# Screening LLM adapter: vertexai (Gemini, default) now; openai_compatible
# (vLLM/Ollama) later. gemini-2.5-flash is the low-latency extraction model.
# Ignored unless AI_MODE=custom.
SCREENING_MODEL_PROVIDER=vertexai
SCREENING_MODEL_NAME=gemini-3.1-flash-lite
# On-prem deployment (AI workstation on the hospital LAN). The base URL is
# REQUIRED with openai_compatible — startup fails rather than falling back to
# api.openai.com. The server must support response_format=json_schema or tool
# calling (vLLM does). Contract + exact request bodies: docs/ai-model-io.md,
# postman/"AI Model (local inference)". The surveillance extractor uses the
# same provider, so nothing reaches Google once this is switched.
# SCREENING_MODEL_PROVIDER=openai_compatible
# SCREENING_OPENAI_BASE_URL=http://<ai-workstation>:8000/v1
# SCREENING_OPENAI_API_KEY=
# SCREENING_MODEL_NAME=Qwen2.5-7B-Instruct

# ── Speech backends (STT/TTS) ───────────────────────────────────────────────
# google (default) = Cloud Speech-to-Text / Text-to-Speech.
# openai_compatible = any OpenAI-audio-compatible HTTP server, so patient
# AUDIO stays in the hospital (faster-whisper-server / Speaches for STT,
# kokoro-fastapi / openedai-speech for TTS). Base URLs include /v1.
STT_PROVIDER=google
TTS_PROVIDER=google
# STT_BASE_URL=http://localhost:8080/v1
# STT_MODEL=Systran/faster-whisper-large-v3
# STT_API_KEY=
# TTS_BASE_URL=http://localhost:8081/v1
# TTS_MODEL=tts-1
# TTS_API_KEY=
# Local voices per language (TTS_VOICE_TH/EN above are Google voice names).
# TTS_LOCAL_VOICE_TH=alloy
# TTS_LOCAL_VOICE_EN=alloy
# SPEECH_HTTP_TIMEOUT_S=30

# ── Hospital HIS integration ────────────────────────────────────────────────

# Hospital HIS. mock = logs referrals, accepts every visit (no external DB).
# http = talk to the hospital HIS API, or the local hospital-his-mock service.
HIS_MODE=http
HIS_BASE_URL=http://localhost:8001
HIS_API_KEY=demo-his-key
# Panel title shown in admin → Database Settings once connected. Admins can
# (re)establish the connection from that tab (endpoint + name); the choice is
# applied live and persisted back into this file.
HIS_DISPLAY_NAME=Hospital DB

# Omron blood pressure cuff (omblepy) integration.
# BP_DEVICE_MAC: macOS CoreBluetooth UUID (or MAC on win/linux) of the cuff,
# found via `python omblepy.py -p -d <model>` device scan. Pair once with -p.
BP_DEVICE_NAME=hem-7280t
BP_DEVICE_MAC=
# Optional overrides: BP_OMBLEPY_DIR (defaults to <repo>/omblepy),
# BP_PYTHON_BIN (defaults to the API's python), BP_FETCH_TIMEOUT_SECONDS=120

# BLE thermometer (any standard Health Thermometer device, e.g. TAIDOC TD1242).
# Normally written by the admin portal's device manager (scan -> connect);
# both keys update automatically when a new thermometer is paired.
TEMP_DEVICE_NAME=
TEMP_DEVICE_MAC=
# Fingertip pulse oximeter (Rossmax SB210, advertises as RM_SPO2); pair from
# the admin device settings — it fills these in.
SPO2_DEVICE_NAME=
SPO2_DEVICE_MAC=
# Optional: TEMP_FETCH_TIMEOUT_SECONDS=90
# Gemini 3+ thinking depth for the screening engine: minimal|low|medium|high
SCREENING_THINKING_LEVEL=minimal
