# local-speech gateway config. Copy to .env (gitignored) and edit.
# Real environment variables override anything set here.

# ── TTS engine, per language ───────────────────────────────────────────────
# mms — facebook/mms-tts-* (VITS). Fast (~0.09 s), but the THAI checkpoint is
#       a MALE voice, and th/en are different speakers.
# f5  — F5-TTS-THAI voice cloning from the reference below. Female nurse
#       voice, one speaker across both languages. ~0.7 s per utterance.
TTS_ENGINE_TH=f5
TTS_ENGINE_EN=f5

# ── F5 reference clip ──────────────────────────────────────────────────────
# REQUIRED when either engine is f5. The transcript must match the audio
# EXACTLY — F5 aligns the clip against it, and a wrong word degrades the clone
# in a way that reads as "the model is bad".
# 5-15 s of clean speech works best; under ~3 s gives unstable timbre.
TTS_REF_AUDIO_TH=C:/Users/SE/AI-OPD-Prescreening-Triage-System/local-speech/download.wav
TTS_REF_TEXT_TH=สวัสดีค่ะ ยินดีต้อนรับแล้วค่ะ
# Optional. Unset means English clones from the Thai clip above, which is what
# gives one nurse voice in both languages.
# TTS_REF_AUDIO_EN=
# TTS_REF_TEXT_EN=

# Sampling. More steps is slower and slightly better; 32 is the F5 default.
# F5_STEPS=32
# F5_CFG=2.0

# ── Voice pacing ───────────────────────────────────────────────────────────
# Slightly under 1.0 reads as a calmer, less hurried nurse. Applies to
# whichever engine serves that language.
TTS_SPEED_TH=0.95
TTS_SPEED_EN=1.0

# ── STT ────────────────────────────────────────────────────────────────────
# STT_MODEL_SIZE=large-v3-turbo
# STT_DEVICE=cuda
# STT_COMPUTE_TYPE=float16
# STT_BEAM_SIZE=1

# ── Devices / upstream ─────────────────────────────────────────────────────
# TTS_DEVICE=cuda
# OLLAMA_URL=http://127.0.0.1:11434
# LLM_TIMEOUT_S=180

# Pin this model in VRAM at startup (keep_alive=-1). Must match ollama list.
LLM_PIN_MODEL=scb10x/llama3.1-typhoon2-8b-instruct
