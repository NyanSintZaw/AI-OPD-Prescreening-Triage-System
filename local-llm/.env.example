# local-llm gateway. Copy to .env (gitignored) and edit.

# Where Ollama actually listens. It binds 127.0.0.1 and should STAY that way —
# this process is what makes it reachable from elsewhere.
OLLAMA_URL=http://127.0.0.1:11434

# Hold this model in VRAM so the first patient never pays the cold load
# (~11 s warm-disk, ~75 s cold, against the backend's 30 s model timeout).
# Must match a name in `ollama list`. Leave unset to load on first use.
LLM_PIN_MODEL=scb10x/llama3.1-typhoon2-8b-instruct

# Re-assert the pin this often. Ollama is frequently shared; another client
# loading a different model evicts ours. 0 disables.
LLM_PIN_INTERVAL_S=60

# Hard cap per upstream call.
LLM_TIMEOUT_S=180

# Narrow once the calling origins are known.
# CORS_ORIGINS=http://localhost:5173

# LOG_VERBOSE=1 restores httpx/uvicorn chatter.
