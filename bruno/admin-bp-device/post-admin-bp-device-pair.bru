meta {
  name: POST /admin/bp-device/pair
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/admin/bp-device/pair
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "mac": "string",
    "device_name": "string"
  }
}

docs {
  Program the pairing key into the selected cuff and make it the
  active kiosk device (persists to .env, effective immediately).
  
  Roles: super_admin, nurse.
}
