meta {
  name: POST /doctors/{doctor_id}/schedules
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/doctors/{{doctor_id}}/schedules
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "schedule_date": "string",
    "start_time": "string",
    "end_time": "string",
    "break_start": "string",
    "break_end": "string",
    "room": "string",
    "slot_label": "string",
    "is_available": true,
    "notes": "string"
  }
}

docs {
  Add a date-specific schedule entry for a doctor.
  
  Roles: super_admin, admin.
}
