meta {
  name: PATCH /doctors/{doctor_id}/schedules/{schedule_id}
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/doctors/{{doctor_id}}/schedules/{{schedule_id}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "schedule_date": "string",
    "start_time": "string",
    "end_time": "string",
    "break_start": "string",
    "break_end": "string",
    "room": "string",
    "slot_label": "string",
    "is_available": true,
    "notes": "string"
  }
}

docs {
  Update an existing schedule entry.
  
  Roles: super_admin, nurse.
}
