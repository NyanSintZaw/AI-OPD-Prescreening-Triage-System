meta {
  name: PATCH /doctors/{doctor_id}
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/doctors/{{doctor_id}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "full_name": "string",
    "title": "string",
    "specialization": "string",
    "department_id": "00000000-0000-0000-0000-000000000000",
    "phone_ext": "string",
    "notes": "string",
    "is_active": false
  }
}

docs {
  Update a doctor profile. Requires admin or nurse role.
  
  Roles: super_admin, nurse.
}
