meta {
  name: POST /admin/reviews/{assessment_id}/correct
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/admin/reviews/{{assessment_id}}/correct
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "confirmed_department_id": "00000000-0000-0000-0000-000000000000",
    "reason": "string",
    "ai_assessment_score": 0,
    "chief_complaint": "string",
    "illness_note": "string"
  }
}

docs {
  Correct Assessment Review
  
  Roles: admin, super_admin.
}
