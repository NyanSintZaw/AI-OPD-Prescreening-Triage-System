meta {
  name: POST /admin/reviews/{assessment_id}/approve
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/admin/reviews/{{assessment_id}}/approve
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "notes": "string",
    "ai_assessment_score": 0,
    "chief_complaint": "string",
    "illness_note": "string"
  }
}

docs {
  Approve Assessment Review
  
  Roles: nurse, super_admin.
}
